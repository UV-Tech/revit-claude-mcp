{
  "name": "revit-mcp-server",
  "version": "2.0.0",
  "description": "Local MCP server for controlling Revit 2026 through the RevitMCP addin.",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
